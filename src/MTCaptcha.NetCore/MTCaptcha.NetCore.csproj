<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Package Metadata -->
    <PackageId>MTCaptcha.NetCore</PackageId>
    <Version>0.5.0</Version>
    <Authors>MTCaptcha</Authors>
    <Description>MTCaptcha integration library for .NET Core. Provides server-side token verification for MTCaptcha in ASP.NET Core applications.</Description>
    <PackageTags>mtcaptcha;captcha;security;verification;aspnetcore;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/mtcaptcha-public/mtcaptcha-dot-net</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/mtcaptcha-public/mtcaptcha-dot-net</PackageProjectUrl>
  </PropertyGroup>

<ItemGroup>
    <!-- Contains IServiceCollection, AddHttpClient extension, HttpClientFactory -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0-preview.3.24172.9" />

    <!-- Required for Options pattern (IOptions<> / Configure()) -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0-preview.3.24172.9" />

    <!-- Logging abstractions for ILogger support -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0-preview.3.24172.9" />

    <!-- JSON HTTP helpers: PostAsJsonAsync, ReadFromJsonAsync -->
    <PackageReference Include="System.Net.Http.Json" Version="9.0.0-preview.3.24172.9" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
